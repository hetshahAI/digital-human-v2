# Digital Human V2 - Environment Variables
# Copy this file to .env and fill in your values

# -----------------
# Core Application
# -----------------
HOST=0.0.0.0
PORT=8000
DEBUG=True
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# -----------------
# ASR (Speech-to-Text) Configuration
# -----------------
ASR_PROVIDER=nvidia
# Required if using NVIDIA's NeMo/NVIDIA NIM for ASR
NVIDIA_API_KEY=YOUR_API_KEY_HERE

ASR_MODEL_PATH=./models/asr/
ASR_SAMPLE_RATE=16000
ASR_CHUNK_SIZE=1024

# -----------------
# LLM (Conversation) Configuration
# -----------------
LLM_PROVIDER=manysphere
LLM_API_URL=https://exo.manysphere.info/v1
LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=128
# Required API key for Manysphere backend orchestration
MANYSPHERE_API_KEY=YOUR_API_KEY_HERE

# -----------------
# TTS (Text-to-Speech) Configuration
# -----------------
TTS_PROVIDER=kokoro
# Required: local Kokoro deployment URL
KOKORO_URL=http://127.0.0.1:8090/v1/audio/speech
KOKORO_MODEL=Kokoro_no_espeak_Q8
KOKORO_TIMEOUT=10

# Fallback: Qwen3-TTS
QWEN_TTS_URL=http://127.0.0.1:8080/v1/audio/speech
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_TIMEOUT=10.0

TTS_MODEL_PATH=./models/tts/
TTS_SAMPLE_RATE=24000
TTS_VOICE=af_heart

# -----------------
# Animation & Lip Sync Configuration
# -----------------
ANIMATION_PROVIDER=neurosync
# Required: NeuroSync microservice URL for audio-to-blendshapes processing
NEUROSYNC_API_URL=http://127.0.0.1:5000/audio_to_blendshapes

AVATAR_MODEL_PATH=./models/avatar/
# Default path for the frontend asset 
DEFAULT_VRM_MODEL=./frontend/public/avatar.vrm
ANIMATION_FPS=30
BLEND_SHAPES_COUNT=52

# -----------------
# Streaming
# -----------------
WEBSOCKET_HEARTBEAT=30
STREAM_BUFFER_SIZE=4096
SECRET_KEY=YOUR_SECRET_KEY_HERE
